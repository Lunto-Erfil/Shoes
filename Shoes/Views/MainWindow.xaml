<Window x:Class="Shoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список товаров — ООО «Обувь»"
        Width="1180" Height="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== Шапка ====== -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBgBrush}"
                CornerRadius="6" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Resources/logo.png"
                       Height="52" Stretch="Uniform" Margin="0,0,14,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ООО «Обувь» — информационная система"
                               FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="txtUserInfo" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="btnOrders" Content="Заказы"
                            Style="{StaticResource BaseButton}"
                            Margin="0,0,8,0" Click="BtnOrders_Click"
                            Visibility="Collapsed"/>
                    <Button x:Name="btnAdd" Content="Добавить товар"
                            Style="{StaticResource AccentButton}"
                            Margin="0,0,8,0" Click="BtnAdd_Click"
                            Visibility="Collapsed"/>
                    <Button Content="Выход"
                            Style="{StaticResource BaseButton}"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== Фильтры ====== -->
        <Border x:Name="pnlFilters" Grid.Row="1"
                BorderBrush="{StaticResource BorderBrushGray}"
                BorderThickness="1" CornerRadius="6"
                Padding="10" Margin="0,10,0,10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" Margin="0,0,6,0"/>
                <TextBox x:Name="txtSearch" Width="280"
                         TextChanged="Filter_Changed"/>

                <TextBlock Text="Поставщик:" Margin="20,0,6,0"/>
                <ComboBox x:Name="cmbSupplier" Width="200"
                          SelectionChanged="Filter_Changed"/>

                <TextBlock Text="Сортировка по кол-ву:" Margin="20,0,6,0"/>
                <ComboBox x:Name="cmbSort" Width="180"
                          SelectedIndex="0"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="По возрастанию"/>
                    <ComboBoxItem Content="По убыванию"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ====== Список ====== -->
        <ListBox Grid.Row="2" x:Name="lstProducts"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="LstProducts_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrushGray}"
                            BorderThickness="1"
                            Margin="0,3" Padding="10"
                            Background="{Binding RowBrush}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Height="110" Stretch="Uniform"
                                   Source="{Binding PhotoFullPath}"/>

                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock FontWeight="Bold" FontSize="15">
                                    <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                    <Run Text="Описание товара: "/>
                                    <Run Text="{Binding Description, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Производитель: "/>
                                    <Run Text="{Binding ManufacturerName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Поставщик: "/>
                                    <Run Text="{Binding SupplierName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Цена: "/>
                                    <Run Text="{Binding OldPriceText, Mode=OneWay}"
                                         Foreground="Red"
                                         TextDecorations="Strikethrough"/>
                                    <Run Text="{Binding PriceText, Mode=OneWay}"
                                         Foreground="Black"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Единица измерения: "/>
                                    <Run Text="{Binding UnitName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Количество на складе: "/>
                                    <Run Text="{Binding StockQuantity, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    BorderBrush="{StaticResource BorderBrushGray}"
                                    BorderThickness="1"
                                    Background="{StaticResource SecondaryBgBrush}"
                                    CornerRadius="4" Padding="8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Действующая"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="скидка"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%, Mode=OneWay}"
                                               FontWeight="Bold" FontSize="22"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" x:Name="txtStatus" Foreground="#555"
                   Margin="4,8,0,0"/>
    </Grid>
</Window>
