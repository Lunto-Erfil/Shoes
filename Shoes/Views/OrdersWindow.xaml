<Window x:Class="Shoes.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы — ООО «Обувь»"
        Width="1000" Height="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBgBrush}"
                CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="Список заказов" FontSize="18" FontWeight="Bold"/>
                <Button x:Name="btnAddOrder" Content="Добавить заказ"
                        Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Right"
                        Click="BtnAddOrder_Click"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>

        <ListBox Grid.Row="1" x:Name="lstOrders"
                 HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="LstOrders_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrushGray}"
                            BorderThickness="1" Margin="0,3" Padding="10"
                            Background="White" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold" FontSize="15">
                                    <Run Text="Заказ №"/>
                                    <Run Text="{Binding Id, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0">
                                    <Run Text="Артикул заказа: "/>
                                    <Run Text="{Binding ArticlesDisplay, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Статус заказа: "/>
                                    <Run Text="{Binding StatusName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Адрес пункта выдачи: "/>
                                    <Run Text="{Binding PickupAddress, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="ФИО клиента: "/>
                                    <Run Text="{Binding UserFullName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Код для получения: "/>
                                    <Run Text="{Binding PickupCode, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Дата заказа: "/>
                                    <Run Text="{Binding OrderDateText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource BorderBrushGray}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="{StaticResource SecondaryBgBrush}"
                                    Padding="8"
                                    VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Дата доставки"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DeliveryDateText, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               FontSize="16"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Обновить"
                    Style="{StaticResource BaseButton}"
                    Margin="0,0,8,0"
                    Click="BtnRefresh_Click"/>
            <Button Content="Назад"
                    Style="{StaticResource BaseButton}"
                    Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>