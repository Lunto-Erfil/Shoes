<Window x:Class="Shoes.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ" Width="700" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Номер заказа:" Margin="0,4"/>
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtNumber" Margin="0,4"
                   IsReadOnly="True" Background="#F0F0F0"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус заказа:" Margin="0,4"/>
        <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cmbStatus" Margin="0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Адрес пункта выдачи:" Margin="0,4"/>
        <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="cmbPickup" Margin="0,4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Клиент:" Margin="0,4"/>
        <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="cmbClient" Margin="0,4"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата заказа:" Margin="0,4"/>
        <DatePicker Grid.Row="4" Grid.Column="1" x:Name="dpOrderDate" Margin="0,4"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Дата доставки:" Margin="0,4"/>
        <DatePicker Grid.Row="5" Grid.Column="1" x:Name="dpDeliveryDate" Margin="0,4"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Код для получения:" Margin="0,4"/>
        <TextBox   Grid.Row="6" Grid.Column="1" x:Name="txtCode" Margin="0,4"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Состав заказа:" Margin="0,8"
                   VerticalAlignment="Top"/>
        <Grid Grid.Row="7" Grid.Column="1" Margin="0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dgItems" Grid.Row="0" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул"
                                        Binding="{Binding ProductArticle}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Кол-во"
                                        Binding="{Binding Quantity}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,6,0,0">
                <ComboBox x:Name="cmbProductToAdd" Width="160" Margin="0,0,6,0"/>
                <TextBox  x:Name="txtQtyToAdd" Width="60" Margin="0,0,6,0"/>
                <Button Content="Добавить позицию"
                        Style="{StaticResource BaseButton}"
                        Click="BtnAddItem_Click"/>
                <Button Content="Удалить выделенную"
                        Style="{StaticResource BaseButton}"
                        Margin="6,0,0,0"
                        Click="BtnRemoveItem_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить"
                    Style="{StaticResource AccentButton}"
                    Width="120" Margin="0,0,8,0"
                    Click="BtnSave_Click"/>
            <Button x:Name="btnDelete" Content="Удалить"
                    Style="{StaticResource DangerButton}"
                    Width="120" Margin="0,0,8,0"
                    Click="BtnDelete_Click"/>
            <Button Content="Назад"
                    Style="{StaticResource BaseButton}"
                    Width="120" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
